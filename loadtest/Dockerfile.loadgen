# syntax=docker/dockerfile:1
# Image of the load generator only; the service image is the root Dockerfile.
# Go version must match the go directive in go.mod.
FROM golang:1.26.10-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/loadgen ./cmd/loadgen
RUN go build -trimpath -ldflags="-s -w" -o /out/loadgen ./cmd/loadgen

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loadgen /app/loadgen
USER nonroot:nonroot
EXPOSE 9100
ENTRYPOINT ["/app/loadgen"]
