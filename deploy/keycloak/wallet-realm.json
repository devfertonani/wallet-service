{
  "realm": "wallet",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "wagering-provider", "description": "Game provider: submits and reads its own wager transactions" },
      { "name": "wallet-internal", "description": "Internal service: opens wallets, reads wallets and ledgers, runs reconciliation" }
    ]
  },
  "clientScopes": [
    {
      "name": "wallet-api",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "wallet-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "wallet-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "access.token.claim": "true", "jsonType.label": "String" }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "provider-a",
      "secret": "provider-a-secret",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["wallet-api"],
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-a", "jsonType.label": "String", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "secret": "provider-b-secret",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["wallet-api"],
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-b", "jsonType.label": "String", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "provider-a-short-lived",
      "description": "Same identity as provider-a with a 2 s token, used by the expired-token test",
      "secret": "provider-a-short-lived-secret",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["wallet-api"],
      "attributes": { "access.token.lifespan": "2" },
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-a", "jsonType.label": "String", "access.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "wallet-internal",
      "secret": "wallet-internal-secret",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["wallet-api"]
    },
    {
      "clientId": "no-role-client",
      "description": "Valid token for the right audience but without any role, used by authorization tests",
      "secret": "no-role-client-secret",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["wallet-api"]
    }
  ],
  "users": [
    { "username": "service-account-provider-a", "enabled": true, "serviceAccountClientId": "provider-a", "realmRoles": ["wagering-provider"] },
    { "username": "service-account-provider-b", "enabled": true, "serviceAccountClientId": "provider-b", "realmRoles": ["wagering-provider"] },
    { "username": "service-account-provider-a-short-lived", "enabled": true, "serviceAccountClientId": "provider-a-short-lived", "realmRoles": ["wagering-provider"] },
    { "username": "service-account-wallet-internal", "enabled": true, "serviceAccountClientId": "wallet-internal", "realmRoles": ["wallet-internal"] },
    { "username": "service-account-no-role-client", "enabled": true, "serviceAccountClientId": "no-role-client", "realmRoles": [] }
  ]
}
