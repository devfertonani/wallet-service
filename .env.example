# Local example values only. Copy to .env: cp .env.example .env
# docker-compose.yml overrides the hostnames that differ inside the network.

HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=25s
# Deadline of one HTTP request, database included; exceeded means 503.
HTTP_REQUEST_TIMEOUT=10s
LOG_LEVEL=info

# Service login (member of wallet_app, no UPDATE/DELETE on the ledger).
DATABASE_URL=postgres://wallet_service:wallet_service@localhost:55432/wallet?sslmode=disable
DB_MAX_CONNS=10
# Wait for a wallet row lock before answering 503 / returning the message.
DB_LOCK_TIMEOUT=3s
# Schema owner, used only by the migrate command.
MIGRATIONS_DATABASE_URL=postgres://wallet_owner:wallet_owner@localhost:55432/wallet?sslmode=disable
# Host port of the Compose Postgres (change it if 55432 is taken; update the
# URLs above and TEST_ADMIN_DATABASE_URL accordingly).
POSTGRES_HOST_PORT=55432
# Superuser URL used by the integration tests to create throwaway databases.
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:55432/postgres?sslmode=disable

# MiniStack accepts any credentials; real AWS uses the default chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=000000000000
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
WAGER_QUEUE_NAME=wager-transactions.fifo
WAGER_DLQ_NAME=wager-transactions-dlq.fifo
EVENTS_TOPIC_NAME=wallet-events.fifo
# Create queues/topic at start (idempotent). Local emulator only.
AWS_AUTO_PROVISION=false

# SQS consumer: goroutines per instance, long poll, per-message deadline
# (must stay below the 30s visibility timeout).
SQS_WORKERS=4
SQS_WAIT_TIME=10s
SQS_MESSAGE_TIMEOUT=10s

# Outbox publisher.
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL=200ms
OUTBOX_LEASE=30s

# Operations waiting for a reference: backoff min(base*2^n, max), TTL.
PENDING_BASE_DELAY=1s
PENDING_MAX_DELAY=60s
PENDING_TTL=10m
PENDING_POLL_INTERVAL=500ms

# Keycloak realm imported from deploy/keycloak/wallet-realm.json.
OIDC_ISSUER_URL=http://localhost:8081/realms/wallet
OIDC_JWKS_URL=http://localhost:8081/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
